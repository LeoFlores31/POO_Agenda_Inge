<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="467.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.CrearPacienteController">
    <children>
        <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#cccccc" height="95.0" stroke="BLACK" strokeType="INSIDE" width="700.0" />
        <Label layoutX="288.0" layoutY="31.0" text="Crear Paciente" textFill="#333333">
            <font>
                <Font size="27.0" />
            </font>
        </Label>
        <Label layoutX="201.0" layoutY="136.0" text="Nombre" />
        <TextField fx:id="txtNombre" layoutX="264.0" layoutY="132.0" prefHeight="26.0" prefWidth="226.0" promptText="nombre" />
        <Label layoutX="201.0" layoutY="192.0" text="Telefono" />
        <TextField fx:id="txtTelefono" layoutX="264.0" layoutY="188.0" prefHeight="26.0" prefWidth="226.0" promptText="telefono" />
        <Label layoutX="201.0" layoutY="247.0" text="Email" />
        <TextField fx:id="txtEmail" layoutX="264.0" layoutY="243.0" prefHeight="26.0" prefWidth="226.0" promptText="email" />

        <Button fx:id="btnCrearPaciente" layoutX="232.0" layoutY="318.0" mnemonicParsing="false" onAction="#crearPaciente" prefHeight="39.0" prefWidth="106.0" style="-fx-background-color: #2196F3;" text="Crear Paciente" textFill="WHITE" />
        <Button fx:id="btnRegresar" layoutX="372.0" layoutY="318.0" mnemonicParsing="false" onAction="#regresar" prefHeight="39.0" prefWidth="106.0" style="-fx-background-color: #333333;" text="Regresar" textFill="WHITE" />
      <Label fx:id="lblErrorEmail" layoutX="264.0" layoutY="279.0" prefHeight="17.0" prefWidth="226.0" text="* ¡Email ya registrado o inválido!" textFill="RED" visible="false" />
      <Label fx:id="lblEmailValido" layoutX="264.0" layoutY="279.0" prefHeight="17.0" prefWidth="226.0" text="Email valido" textFill="#02bc27" visible="false" />

    </children>
</AnchorPane>
